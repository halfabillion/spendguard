# Copy to .env locally. Never commit secrets. Never export keys into the shell history.
TELEGRAPH_MODE=mock
# live paths: x402 (wallet-signed, default for live-once) or key (Anjoman API key escrow)
TELEGRAPH_PAY=x402
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine/v1/ask
TELEGRAPH_API_URL=https://backend.telegraphprotocol.com
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Secret files live in ../.secrets/ (gitignored). Do not paste values here.
# TELEGRAPH_API_KEY_PATH=../.secrets/anjoman_api_key
# TELEGRAPH_EOA_KEY_PATH=../.secrets/sepolia-eoa.key
SPENDGUARD_MAX_COST_USD=0.05
SPENDGUARD_LEDGER_PATH=.ledger.json
